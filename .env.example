# Copy to .env and fill in the placeholders:  cp .env.example .env
# .env is gitignored and never committed. This example holds no real secrets.
# docker compose reads .env automatically. For `dotnet run`, export it first:
#   set -a; . ./.env; set +a

# PostgreSQL superuser password. `postgres` is the assignment's own public value
# (the §3.1 docker run one-liner); the API's default connection string uses it.
POSTGRES_PASSWORD=postgres

# JWT signing key (HMAC). Generate one with:  openssl rand -base64 48
# Optional in Development and Test: if unset, the API uses a random per-process
# key and logs a warning (tokens then stop working after a restart).
Jwt__SigningKey='<PLACEHOLDER>'

# Password for the seeded demo users alice (WH-A), bob (WH-B) and carol (no links).
# Choose any value; the API hashes it at startup. If unset, the demo users
# cannot log in and the API logs a warning. Demo-only: never reuse it elsewhere.
DemoUsers__Password='<PLACEHOLDER>'

# Added after the four-hour build. Compose only: true serves the Swagger UI at /swagger
# and the OpenAPI document at /openapi/v1.json, both without a token, for local use.
# Must stay false in production. (`dotnet run` in Development serves them by default.)
OPENAPI_ENABLED=false
